# Server-side only — never prefixed with VITE_, so nothing here is bundled into the browser.
# Set ONE of the two keys. If both are set, Claude is used unless AI_PROVIDER=gemini.

# Option A: Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite     # default; fast (~1-2s). gemini-3.8-flash is smarter but slow on the free tier

# Option B: Anthropic Claude (paid, prepaid credits) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5          # or claude-haiku-4-5 for roughly 5x lower cost

# AI_PROVIDER=claude                     # force one provider when both keys are set
